{
  "name": "@ona/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed.ts",
    "test": "node --test test/",
    "e2e": "node --env-file=.env scripts/e2e-parcours.js",
    "db:seed-odu": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed-odu-domains.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@ona/core": "*",
    "@prisma/client": "^6.2.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.1",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "prisma": "^6.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
